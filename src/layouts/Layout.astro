---
import "../styles/global.css";
import Footer from "../components/astro/Footer.astro";
import Navbar from "../components/astro/Navbar.astro";

let { pageTitle } = Astro.props;

pageTitle = pageTitle ? pageTitle : "Dylan Halstead";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const description =
	"Dylan Halstead - Software Engineer from Charlotte, NC building performant, scalable software solutions.";
const image =
	"https://storage.googleapis.com/halstead_portfolio_images/Personal_Portfolio.png";
---
<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<title>{pageTitle}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<!-- Performance optimizations -->
		<link rel="dns-prefetch" href="https://storage.googleapis.com/">
		<link rel="preconnect" href="https://storage.googleapis.com/" crossorigin>
		<meta http-equiv="Accept-CH" content="DPR, Viewport-Width, Width">

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://dylanhalstead.com/" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:site_name" content="Dylan Halstead" />
		<meta property="og:locale" content="en_US" />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://dylanhalstead.com/" />
		<meta property="twitter:title" content={pageTitle} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={image} />
		
		<!-- Additional SEO and Social Tags -->
		<meta name="author" content="Dylan Halstead" />
		<meta name="keywords" content="software engineer, web developer, backend, Charlotte NC, full stack, software development, programming, coding" />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#0f0f23" />
		<meta name="msapplication-TileColor" content="#0f0f23" />
	</head>
	<body class="text-text-100 bg-background-950 font-karla min-h-screen flex flex-col justify-between">
		<Navbar />
		<slot />
		<Footer />
	</body>
</html>