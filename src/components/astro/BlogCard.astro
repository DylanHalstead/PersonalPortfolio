---
import Clock from '../../assets/clock.svg';
import Arrow from '../../assets/arrow.svg';
import type { CollectionEntry } from 'astro:content';

interface Props {
  color?: 'primary' | 'secondary' | 'light' | 'dark';
  additionalWrapperClasses?: string[];
  post: CollectionEntry<'blog'>;
}

const { color = '', additionalWrapperClasses = [], post } = Astro.props;

const colors: {
  [key: string]: {
    bgPrimary: string;
    textPrimary: string;
    bgSecondary: string;
    textSecondary: string;
  };
} = {
  primary: {
    bgPrimary: 'bg-primary-500',
    textPrimary: 'text-primary-500',
    bgSecondary: 'bg-text-50',
    textSecondary: 'text-text-50',
  },
  secondary: {
    bgPrimary: 'bg-secondary-500',
    textPrimary: 'text-secondary-500',
    bgSecondary: 'bg-text-950',
    textSecondary: 'text-text-950',
  },
  light: {
    bgPrimary: 'bg-text-50',
    textPrimary: 'text-text-50',
    bgSecondary: 'bg-text-950',
    textSecondary: 'text-text-950',
  },
  dark: {
    bgPrimary: 'bg-text-800',
    textPrimary: 'text-text-800',
    bgSecondary: 'bg-text-50',
    textSecondary: 'text-text-50',
  },
}

const { bgPrimary, textPrimary, textSecondary, bgSecondary } = colors[color] || colors.light;

/**
 * Get a preview of a blog post by taking the first <wordCount> words and removing all markdown syntax
 * @param content - The content of the blog post
 * @param wordCount - The number of words to take from the content
 * @returns The preview of the blog post
 */
const getPreview = (content: string, wordCount: number = 40) => {
  if (!content) return '';
  
  const unsanitizedPreview = content.split(/\s+/).slice(0, wordCount).join(' ');
  
  return unsanitizedPreview
    .replace(/```[\s\S]*?```/g, '') // remove fenced code blocks
    .replace(/`([^`]+)`/g, '$1') // replace inline code with just the content
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // replace [text](url) with just text
    .replace(/\[([^\]]+)\](?!\()/g, '$1') // replace [text] with just text (for reference links)
    .replace(/[#*`_~]|^[-*+]\s+|^\d+\.\s+/gm, '') // remove all markdown syntax
    .trim() + '...';
};

/**
 * Calculate the reading time of a blog post by dividing by the average reading speed (200 WPM)
 * @param content - The content of the blog post
 * @returns The reading time in minutes, rounded to the nearest tenth
 */
const calculateReadingTime = (content: string) => {
  const words = content.split(/\s+/).length;
  return (words / 200).toFixed(1);
};
---

<li class:list={['inline-block', 'text-left', ...additionalWrapperClasses]}>
    <div class:list={[bgPrimary, `p-6`, `rounded-2xl`, `flex` ,`flex-col`, `gap-4`, 'w-sm', 'lg:w-lg']}>
      <div class="flex flex-col gap-3">
        <h3 class:list={['text-2xl', 'lg:text-3xl', 'font-bold', 'cursor-text', textSecondary]}>{post.data.title}</h3>
        <p class:list={['text-base', 'lg:text-lg', 'lg:text-xl/6', 'cursor-text', textSecondary, 'font-light', 'opacity-70', 'line-clamp-3']}>
          {post.body ? getPreview(post.body) : ''}
        </p>
      </div>
      <div class="flex justify-between items-center mt-4">
        <div class="flex items-center gap-1">
          <Clock class:list={['size-5', 'lg:size-6', textSecondary]} />
          <p class:list={[textSecondary, 'text-base', 'lg:text-lg', 'font-light', 'opacity-70']}>{post.body ? calculateReadingTime(post.body) : ''} min read</p>
        </div>
        <a href={`/blog/${post.id}`} aria-label={`Read ${post.data.title}`} class:list={[bgSecondary, 'rounded-lg', 'p-2.5', 'lg:p-1.5', 'group', 'transition-all', 'duration-200']}>
          <Arrow class:list={['size-6', textPrimary, 'group-hover:-rotate-45', 'group-hover:scale-120', 'transition-all', 'duration-200']} />
        </a>
      </div>
    </div>
</li>