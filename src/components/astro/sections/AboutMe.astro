---
import { Image } from "astro:assets";
import Github from "../../../assets/github.svg";
import LinkedIn from "../../../assets/linkedin.svg";
import ViewMoreLink from "../ViewMoreLink.astro";
---

<div class="flex gap-6 md:gap-10 lg:gap-16 xl:gap-20 flex-col lg:flex-row items-center">
  <Image 
    src="https://storage.googleapis.com/halstead_portfolio_images/Landscape_Headshot.webp" 
    alt="Dylan with coworkers" 
    width={1200}
    height={800}
    class="border border-text-50 rounded-lg object-cover aspect-3/2 h-full max-w-full md:max-w-[32rem] lg:max-w-[34rem] xl:max-w-[32rem] 2xl:max-w-[40rem]" 
    loading="lazy"
  />
  <div class="space-y-8 text-center lg:text-left">
    <div class="space-y-4">
      <h2 class="text-6xl/16 xl:text-7xl/20 2xl:text-8xl/26 font-medium tracking-tightest">
        More About Me
      </h2>
      <p class="text-lg/6 lg:text-xl/8 xl:text-2xl/10 text-text-50/75">
        Hi, I'm Dylan! I'm a software engineer based out of Charlotte, NC with a passion for building <span class="text-secondary-500">performant, elegant software solutions</span>. With my experience, I've been able to create applications that not only look great but <span class="text-secondary-500">scale efficiently</span> to meet demanding requirements. Whether architecting microservices, optimizing distributed systems, or crafting intuitive user interfaces, I approach each aspect with the same enthusiasm and attention to detail.
      </p>
    </div>
    <div class=" flex gap-6 lg:justify-between justify-center font-bold">
      <ViewMoreLink href="https://www.linkedin.com/in/dylanhalstead/">
        <LinkedIn class="size-8 xl:size-10 group-hover:text-primary-400 transition-colors" />
      </ViewMoreLink>
      <ViewMoreLink href="https://github.com/DylanHalstead">
        <Github class="size-8 xl:size-10 group-hover:text-primary-400 transition-colors" />
      </ViewMoreLink>
    </div>
  </div>
</div>