---
import { getCollection } from "astro:content";
import AboutMe from "../components/astro/sections/AboutMe.astro";
import CallToAction from "../components/astro/sections/CallToAction.astro";
import ContactMe from "../components/astro/sections/ContactMe.astro";
import Hero from "../components/astro/sections/Hero.astro";
import Posts from "../components/astro/sections/Posts.astro";
import ProjectGallery from "../components/svelte/sections/ProjectGallery.svelte";
import Layout from "../layouts/Layout.astro";
import Section from "../layouts/sections/Section.astro";
import SectionExtended from "../layouts/sections/SectionExtended.astro";

const projects = await getCollection("projects");
const tags = await getCollection("tags");
const posts = await getCollection("blog");
---

<Layout pageTitle="Dylan Halstead">
	<Hero />
	<div class="flex flex-col gap-32 md:gap-48 lg:gap-64">
		<Section>
			<CallToAction />
		</Section>
		<div class="flex flex-col gap-18 lg:gap-32" id="about">
			<Section>
				{posts.length > 0 && <Posts posts={posts} />}
				<AboutMe />
			</Section>
		</div>
		<SectionExtended>
			<div id="projects">
				<ProjectGallery client:only="svelte" projects={projects} tags={tags} />
			</div>
		</SectionExtended>
		<Section>
			<ContactMe />
		</Section>
	</div>
</Layout>