---
import { getCollection } from "astro:content";
import DetailedBlogCard from "../../components/astro/DetailedBlogCard.astro";
import Section from "../../components/astro/sections/Section.astro";
import Layout from "../../layouts/Layout.astro";
import { sortPosts } from "../../utils/sortPosts";

const blogPosts = sortPosts(await getCollection("blog"));
---

<Layout pageTitle="Dylan Halstead">
	<Section>
		<div class="mt-20">
      <div class="space-y-8 xl:space-y-12 md:text-left text-center">
        <h1 class="text-7xl/16 lg:text-8xl/18 xl:text-9xl/20 font-bold tracking-tightest mt-12">My Posts</h1>
        <p class="text-lg/6 lg:text-xl/8 xl:text-2xl/10 italic">
          I write about my experiences and learnings as I build my projects.
        </p>
      </div>
      {blogPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-18">
          {blogPosts.map((post) => (
            <DetailedBlogCard post={post} />
          ))}
        </div>
      ) : (
        <h2 class="text-4xl/16 xl:text-5xl/20 font-light tracking-tightest my-18 md:text-left text-center">
          No posts yet, check back soon!
        </h2>
      )}
    </div>
	</Section>
</Layout>