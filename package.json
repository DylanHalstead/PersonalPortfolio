{
  "name": "personal-portfolio",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:docker": "docker compose -f docker-compose.yml up --build -t personal-portfolio",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.4.1",
    "@astrojs/svelte": "7.1.0",
    "@sveltejs/enhanced-img": "^0.6.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.7",
    "astro": "^5.11.0",
    "gsap": "^3.13.0",
    "svelte": "^5.30.2",
    "tailwindcss": "^4.1.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2"
  },
  "lint-staged": {
    "*.{ts,json,jsonc,astro,svelte}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
